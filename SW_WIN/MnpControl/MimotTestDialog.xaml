<Window x:Class="MnpControl.MimotTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIMOT Abnahmeprüfung (Nadel 1260.x)"
        Height="730"
        Width="580"
        MinHeight="650"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="★  MIMOT ABNAHME-PRÜFLAUF" FontSize="15" FontWeight="Bold" Foreground="#92400E"/>
                    <TextBlock Text="Erstellt ein normgerechtes Testprotokoll (TXT / PDF) nach Mimot-Werksvorschrift." FontSize="11.5" Foreground="#B45309" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 1. Stammdaten -->
        <GroupBox Grid.Row="1" Header="1. Prüfungs-Stammdaten &amp; Modus">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Prüfer-Kürzel -->
                <Label Grid.Row="0" Grid.Column="0" Content="Prüfer-Kürzel (max 4):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtOperator" Grid.Row="0" Grid.Column="2" MaxLength="4" Height="28" Text="MA01"
                         FontFamily="Consolas, monospace" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"/>

                <!-- Zyklen -->
                <Label Grid.Row="0" Grid.Column="4" Content="Zyklen:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtCycles" Grid.Row="0" Grid.Column="6" Height="28" Text="10"
                         FontFamily="Consolas, monospace" FontWeight="Bold" TextAlignment="Right" VerticalContentAlignment="Center"/>

                <!-- Seriennummer -->
                <Label Grid.Row="2" Grid.Column="0" Content="Seriennummer (max 20):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtSerial" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" MaxLength="20" Height="28"
                         Text="00.00.01.12 - 0346" FontFamily="Consolas, monospace" FontWeight="Bold" VerticalContentAlignment="Center" Padding="4,2"/>

                <!-- Testmodus -->
                <Label Grid.Row="4" Grid.Column="0" Content="Prüf-Ablauf:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbModeB" Content="Bestücken (Test B - Antastung &amp; Streuung)" IsChecked="True" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <RadioButton x:Name="RbModeA" Content="Dauertest (Test A - Hub)" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 2. Mechanischer Aufbau -->
        <GroupBox Grid.Row="2">
            <GroupBox.Header>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="2. Mechanischer Aufbau (Checkliste nach Mimot-Protokoll)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button x:Name="BtnSelectAll" DockPanel.Dock="Right" Content="Alle OK" FontSize="11" Padding="6,1" Height="22" Click="BtnSelectAll_Click"/>
                </DockPanel>
            </GroupBox.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,4">
                    <CheckBox x:Name="Chk1" Content="1. Zahnstange gefettet, Kugelführung geölt" IsChecked="True"/>
                    <CheckBox x:Name="Chk2" Content="2. Silikon auf Stecker Druckmotor" IsChecked="True"/>
                    <CheckBox x:Name="Chk3" Content="3. Hebel des Druckmotors freigängig" IsChecked="True"/>
                    <CheckBox x:Name="Chk4" Content="4. Kabel der Lichtschranke fest fixiert" IsChecked="True"/>
                    <CheckBox x:Name="Chk5" Content="5. Sensor oben richtig positioniert und fest" IsChecked="True"/>
                    <CheckBox x:Name="Chk6" Content="6. Z-Motor axial Spiel ok" IsChecked="True"/>
                    <CheckBox x:Name="Chk7" Content="7. Zahnstange hat wenig Spiel und ist leichtgängig" IsChecked="True"/>
                    <CheckBox x:Name="Chk8" Content="8. Oberer Endanschlag bei der Kugelführung" IsChecked="True"/>
                    <CheckBox x:Name="Chk9" Content="9. Kabel von Spannung und Encoder getrennt verlegt" IsChecked="True"/>
                    <CheckBox x:Name="Chk10" Content="10. Schlauchführung befestigt" IsChecked="True"/>
                    <CheckBox x:Name="Chk11" Content="11. Allgemeinzustand einwandfrei" IsChecked="True"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <!-- 3. Bemerkungen -->
        <GroupBox Grid.Row="3" Header="3. Bemerkungen (optional)" Margin="0,0,0,12">
            <TextBox x:Name="TxtRemarks" Height="36" Text="keine" TextWrapping="Wrap" VerticalContentAlignment="Center" Padding="4,2"/>
        </GroupBox>

        <!-- Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCancel" Grid.Column="0" Content="Abbrechen" Height="36" IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="BtnStart" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="&#x25B6;  Prüflauf starten" Height="36" IsDefault="True" Click="BtnStart_Click"/>
        </Grid>
    </Grid>
</Window>
