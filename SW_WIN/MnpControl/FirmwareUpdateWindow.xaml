<Window x:Class="MnpControl.FirmwareUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STM32 In-Field Firmware-Update"
        Width="520"
        Height="360"
        MinWidth="480"
        MinHeight="320"
        Background="#F4F6F9"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        FontSize="12.5"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Bottom Buttons -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnStartUpdate" Grid.Column="0" Content="Firmware auf STM32 übertragen" Height="34"
                    Background="#2563EB" BorderBrush="#1D4ED8" Foreground="#FFFFFF" FontWeight="Bold"
                    Click="BtnStartUpdate_Click"/>
            <Button x:Name="BtnClose" Grid.Column="2" Content="Schließen" Height="34" IsCancel="True"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" Click="BtnClose_Click"/>
        </Grid>

        <StackPanel>
            <!-- 1. File Selection Card -->
            <GroupBox Header="1. Firmware-Datei auswählen (.bin)">
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtFilePath" Grid.Row="0" Grid.Column="0" Height="28" IsReadOnly="True"
                             VerticalContentAlignment="Center" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="6,2"/>
                    <Button x:Name="BtnBrowse" Grid.Row="0" Grid.Column="2" Content="Durchsuchen..." Height="28" Padding="12,0"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" Click="BtnBrowse_Click"/>

                    <TextBlock x:Name="TxtFileInfo" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="Keine Datei ausgewählt" FontSize="11" Foreground="#64748B"/>
                </Grid>
            </GroupBox>

            <!-- 2. Flash Progress Card -->
            <GroupBox Header="2. Übertragung &amp; Flash-Status" Margin="0,10,0,0">
                <StackPanel Margin="0,4,0,2">
                    <ProgressBar x:Name="PrgUpdate" Height="22" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#10B981" Background="#E2E8F0" BorderThickness="0"/>
                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="TxtStatus" Text="Bereit zum Flashen" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock x:Name="TxtProgressPercent" Text="0 %" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#059669"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="Hinweis: Parameterspeicher in Sektor 7 (Schlitten-Profile) bleibt beim Update vollständig erhalten."
                       Margin="4,8,4,0" FontSize="11" Foreground="#64748B" FontStyle="Italic"/>
        </StackPanel>
    </DockPanel>
</Window>
