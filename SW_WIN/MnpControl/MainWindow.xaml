<Window x:Class="MnpControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MnpControl"
        Height="760"
        Width="1240"
        MinHeight="680"
        MinWidth="1080"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status -->
        <Label Grid.Row="0" Grid.Column="0" Content="STATUS" FontWeight="Bold" />
        <TextBox x:Name="TxtStatus"
                 Grid.Row="1" Grid.Column="0"
                 Height="28"
                 FontSize="16"
                 Text=""
                 IsReadOnly="True"
                 VerticalContentAlignment="Center"
                 Margin="0,4,12,0"/>

        <!-- Sensor values -->
        <Grid Grid.Row="3" Grid.Column="0" Grid.RowSpan="5" Margin="0,8,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Nadel Oben Sensor erreicht:"/>
            <TextBox x:Name="TxtNadelOben" Grid.Row="0" Grid.Column="2" Text="" IsReadOnly="True"/>

            <Label Grid.Row="2" Grid.Column="0" Content="Drucksensorwerte (V):"/>
            <TextBox x:Name="TxtDrucksensor" Grid.Row="2" Grid.Column="2" Text="" IsReadOnly="True"/>

            <Label Grid.Row="4" Grid.Column="0" Content="A-Achse Position (inc):"/>
            <TextBox x:Name="TxtAaxisPos" Grid.Row="4" Grid.Column="2" Text="" IsReadOnly="True"/>

            <Label Grid.Row="6" Grid.Column="0" Content="Z-Achse Ist Position (inc):"/>
            <TextBox x:Name="TxtZaxisPosIst" Grid.Row="6" Grid.Column="2" Text="" IsReadOnly="True"/>

            <Label Grid.Row="8" Grid.Column="0" Content="Z-Achse Soll Position (inc):"/>
            <TextBox x:Name="TxtZaxisPosSoll" Grid.Row="8" Grid.Column="2" Text="" IsReadOnly="True"/>

            <Label Grid.Row="10" Grid.Column="0" Content="Z DAC Ausgabe (V):"/>
            <TextBox x:Name="TxtZDac" Grid.Row="10" Grid.Column="2" Text="" IsReadOnly="True"/>
        </Grid>

        <Grid Grid.Row="8" Grid.Column="0" Margin="0,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Live Log (letzte 5 Meldungen)">
                <TextBox x:Name="TxtLiveLog"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"/>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Test Summary">
                <TextBox x:Name="TxtTestSummary"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"/>
            </GroupBox>
        </Grid>

        <!-- Manual axis controls -->
        <StackPanel Grid.Row="4" Grid.Column="1" Grid.RowSpan="3" Orientation="Vertical" VerticalAlignment="Top" Margin="8,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="BtnUp" Content="▲" Width="44" Height="32" Click="BtnUp_Click"/>
                <TextBox x:Name="TxtStepCount" Width="56" Height="32" Margin="8,0,0,0" Text="100" TextAlignment="Right" VerticalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnDown" Content="▼" Width="44" Height="32" Click="BtnDown_Click"/>
                <TextBlock Text="Steps" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="0,14,0,0">
                <TextBlock Text="Geschwindigkeit (manuell)" Margin="0,0,0,4"/>
                <Slider x:Name="SldSpeedLevel" Minimum="1" Maximum="5" Value="5" TickFrequency="1"
                        IsSnapToTickEnabled="True" Width="140" HorizontalAlignment="Left"
                        ValueChanged="SldSpeedLevel_ValueChanged"/>
                <TextBlock x:Name="TxtSpeedLevel" Text="Stufe: 5/5" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Run mode controls -->
        <StackPanel Grid.Row="1" Grid.Column="2" Grid.RowSpan="8" Margin="12,0,0,0" VerticalAlignment="Top">
            <Label Content="Ablaufsteuerung" FontWeight="Bold" Margin="0,0,0,8"/>
            <Button x:Name="BtnStartReferenceRun" Content="Referenzlauf Starten" Height="34" Click="BtnStartReferenceRun_Click" Margin="0,0,0,8"/>
            <Button x:Name="BtnStartDemo" Content="Demo Modus" Height="34" Click="BtnStartDemoRun_Click" Margin="0,0,0,8"/>
            <Button x:Name="BtnStartShort" Content="Kurz Modus" Height="34" Click="BtnStartShortRun_Click" Margin="0,0,0,8"/>
            <Button x:Name="BtnStartLong" Content="Lang Modus" Height="34" Click="BtnStartLongRun_Click" Margin="0,0,0,8"/>
            <Button x:Name="BtnTestStart" Content="⭮/OK" Height="28" Click="BtnTestStart_click" Width="90" HorizontalAlignment="Left"/>

            <Separator Margin="0,14,0,10"/>
            <Label Content="Z-Position (inkr.)" Padding="0" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtZPos" Grid.Column="0" Height="28" VerticalContentAlignment="Center"
                         Text="0" TextAlignment="Right"/>
                <Button x:Name="BtnSetZPos" Grid.Column="2" Content="Setzen" Height="28" Width="52"
                        Click="BtnSetZPos_Click"/>
            </Grid>

            <Separator Margin="0,14,0,10"/>
            <GroupBox Header="PID Tuning (Z-Achse)">
                <StackPanel Margin="8">
                    <Button x:Name="BtnHybridTuning" Content="PID Tuning öffnen..." Height="32" Click="BtnHybridTuning_Click"/>

                    <Grid Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="74"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="KP"/>
                        <TextBox x:Name="TxtPidKpCurrent" Grid.Row="0" Grid.Column="2" IsReadOnly="True" TextAlignment="Right"/>
                        <TextBox x:Name="TxtPidKpNew" Grid.Row="0" Grid.Column="4" TextAlignment="Right"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="KI"/>
                        <TextBox x:Name="TxtPidKiCurrent" Grid.Row="2" Grid.Column="2" IsReadOnly="True" TextAlignment="Right"/>
                        <TextBox x:Name="TxtPidKiNew" Grid.Row="2" Grid.Column="4" TextAlignment="Right"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="KD"/>
                        <TextBox x:Name="TxtPidKdCurrent" Grid.Row="4" Grid.Column="2" IsReadOnly="True" TextAlignment="Right"/>
                        <TextBox x:Name="TxtPidKdNew" Grid.Row="4" Grid.Column="4" TextAlignment="Right"/>

                        <TextBlock Grid.Row="6" Grid.Column="2" Text="Aktuell" HorizontalAlignment="Center" FontSize="11"/>
                        <TextBlock Grid.Row="6" Grid.Column="4" Text="Neu" HorizontalAlignment="Center" FontSize="11"/>

                        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                            <ComboBox x:Name="CmbPidPreset" Width="170" Margin="0,0,6,0" IsEditable="True"/>
                            <Button x:Name="BtnPidPresetApply" Content="Preset übernehmen" Width="130" Click="BtnPidPresetApply_Click"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="5" Columns="2" Rows="3" Margin="0,0,0,0">
                            <Button x:Name="BtnPidRead" Content="PID Lesen" Margin="0,0,6,6" Click="BtnPidRead_Click"/>
                            <Button x:Name="BtnPidApply" Content="Senden" Margin="0,0,0,6" Click="BtnPidApply_Click"/>
                            <Button x:Name="BtnPidSave" Content="Preset speichern" Margin="0,0,6,6" Click="BtnPidSave_Click"/>
                            <Button x:Name="BtnPidLoad" Content="Preset löschen" Margin="0,0,0,6" Click="BtnPidLoad_Click"/>
                            <Button x:Name="BtnPidNeutral" Content="Not-Stopp 2.5V" Grid.ColumnSpan="2" Click="BtnPidNeutral_Click"/>
                        </UniformGrid>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Bottom actions -->
        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnReset"
                    Content="µC RESET"
                    Width="90"
                    Height="42"
                    Background="#FFF4B1A9"
                    Click="BtnReset_Click"/>
            <Button x:Name="BtnStop"
                    Content="STOPP"
                    Width="90"
                    Height="42"
                    Margin="12,0,0,0"
                    Background="#FFFFC700"
                    Click="BtnStop_Click"/>
           <Button x:Name="BtnClearSummary"
                   Content="CLEAR"
                   Width="90"
                   Height="42"
                   Margin="12,0,0,0"
                   Background="#FFFF4444"
                   Foreground="White"
                   Click="BtnClearSummary_Click"/>
        </StackPanel>
    </Grid>
</Window>
