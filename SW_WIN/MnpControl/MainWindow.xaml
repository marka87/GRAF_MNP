<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MnpControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GRAF MNP Control"
        Height="800"
        Width="1260"
        MinHeight="700"
        MinWidth="1080"
        Background="#F4F6F9"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        FontSize="13"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Action Button Style (Blue) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#1D4ED8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Data Display TextBox Style -->
        <Style x:Key="ValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Height" Value="28"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="1.0*" MinWidth="340" MaxWidth="440"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================================= -->
        <!-- LEFT COLUMN: STATUS + LIVE SENSOR DATA + LOGS          -->
        <!-- ======================================================= -->

        <!-- Row 0: Status Banner -->
        <GroupBox Grid.Row="0" Grid.Column="0" Header="SYSTEM STATUS" Margin="0,0,0,10">
            <TextBox x:Name="TxtStatus"
                     Height="34"
                     FontSize="15"
                     FontWeight="Bold"
                     Text="Bereit"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Padding="8,2"
                     BorderThickness="1"
                     TextChanged="TxtStatus_TextChanged"/>
        </GroupBox>

        <!-- Row 1: Sensor & Axis Data -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="Mess- und Positionsdaten" Margin="0,0,0,10">
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Left Sub-Column -->
                <Label Grid.Row="0" Grid.Column="0" Content="Nadel-Oben Sensor:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtNadelOben" Grid.Row="0" Grid.Column="2" Style="{StaticResource ValueTextBoxStyle}" IsReadOnly="True"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Drucksensor (V):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtDrucksensor" Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueTextBoxStyle}" IsReadOnly="True"/>

                <Label Grid.Row="4" Grid.Column="0" Content="A-Achse Position (inc):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtAaxisPos" Grid.Row="4" Grid.Column="2" Style="{StaticResource ValueTextBoxStyle}" IsReadOnly="True"/>

                <!-- Right Sub-Column -->
                <Label Grid.Row="0" Grid.Column="4" Content="Z Ist-Position (inc):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtZaxisPosIst" Grid.Row="0" Grid.Column="6" Style="{StaticResource ValueTextBoxStyle}" IsReadOnly="True"/>

                <Label Grid.Row="2" Grid.Column="4" Content="Z Soll-Position (inc):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtZaxisPosSoll" Grid.Row="2" Grid.Column="6" Style="{StaticResource ValueTextBoxStyle}" IsReadOnly="True"/>

                <Label Grid.Row="4" Grid.Column="4" Content="Z DAC Ausgabe (V):" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtZDac" Grid.Row="4" Grid.Column="6" Style="{StaticResource ValueTextBoxStyle}" IsReadOnly="True"/>
            </Grid>
        </GroupBox>

        <!-- Row 2: Logs (Live Log & Test Summary) -->
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Live Log -->
            <GroupBox Grid.Column="0">
                <GroupBox.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Live Log (Verlauf)" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <Button DockPanel.Dock="Right" Content="Log leeren" Padding="8,1" FontSize="11" Height="22" Click="BtnClearLog_Click"/>
                    </DockPanel>
                </GroupBox.Header>
                <TextBox x:Name="TxtLiveLog"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas, monospace"
                         FontSize="11.5"
                         Background="#FAFAFA"
                         Foreground="#1E293B"
                         BorderThickness="0"/>
            </GroupBox>

            <!-- Test Summary & Visual Scatter Chart -->
            <GroupBox Grid.Column="2" Header="Test Summary &amp; Statistik">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="130"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="TxtTestSummary"
                             Grid.Row="0"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, monospace"
                             FontSize="11.5"
                             Background="#FAFAFA"
                             Foreground="#1E293B"
                             BorderThickness="0"/>

                    <Border Grid.Row="1" Background="#E2E8F0" Height="1" Margin="0,4,0,4"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="2,0,2,2" LastChildFill="False">
                            <TextBlock x:Name="TxtScatterBadge" Text="Live Streuungs-Diagramm (&#x394; Inkremente)" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7"/>
                            <TextBlock x:Name="TxtScatterStatsLive" DockPanel.Dock="Right" Text="Warte auf Messwerte..." FontSize="10" Foreground="#64748B"/>
                        </DockPanel>
                        <Border Grid.Row="1" CornerRadius="4" Background="#0F172A" ClipToBounds="True">
                            <Canvas x:Name="CanvasScatter" ClipToBounds="True" SizeChanged="CanvasScatter_SizeChanged"/>
                        </Border>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ======================================================= -->
        <!-- RIGHT COLUMN: CONTROL PANELS                           -->
        <!-- ======================================================= -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

                <!-- Ablaufsteuerung Card -->
                <GroupBox Header="Ablaufsteuerung &amp; Testl&#xE4;ufe">
                    <StackPanel Margin="2">
                        <Button x:Name="BtnStartReferenceRun"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="&#x25B6;  Referenzlauf starten"
                                Height="36"
                                Margin="0,0,0,10"
                                Click="BtnStartReferenceRun_Click"/>

                        <!-- Test Cycles Input -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zyklenzahl:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBox x:Name="TxtTestCycles" Grid.Column="2" Height="30" Text="10" TextAlignment="Right"
                                     VerticalContentAlignment="Center" Padding="6,2" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                        </Grid>

                        <!-- Test B Parameter (Druckmotor & Schwelle) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Druckmotor (V):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtDMotVoltage" Height="28" Text="3.5" TextAlignment="Right"
                                         VerticalContentAlignment="Center" Padding="4,2" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Schwelle &#x394; (mV):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,2"/>
                                <TextBox x:Name="TxtTriggerDeltaMv" Height="28" Text="1500" TextAlignment="Right"
                                         VerticalContentAlignment="Center" Padding="4,2" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <!-- Test A & Test B Buttons -->
                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button x:Name="BtnStartTestA" Content="&#x25B6;  Test A (Dauer)" Height="34" Margin="0,0,4,0"
                                    Background="#F8FAFC" FontWeight="SemiBold" Click="BtnStartTestA_Click"/>
                            <Button x:Name="BtnStartTestB" Content="Test B (Antastung)" Height="34" Margin="4,0,0,0"
                                    Background="#EFF6FF" BorderBrush="#3B82F6" Foreground="#1D4ED8" FontWeight="Bold" Click="BtnStartTestB_Click"/>
                        </UniformGrid>

                        <Button x:Name="BtnTestStart"
                                Content="Start-Freigabe (OK)"
                                Height="30"
                                Background="#F1F5F9"
                                Click="BtnTestStart_click"/>
                    </StackPanel>
                </GroupBox>

                <!-- Manuelle Z-Achsen Steuerung Card -->
                <GroupBox Header="Manuelle Z-Achsen-Steuerung">
                    <StackPanel Margin="2">
                        <!-- Up / Down Steps -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnUp" Grid.Column="0" Content="&#x25B2;  HOCH" Width="80" Height="34" Click="BtnUp_Click"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBox x:Name="TxtStepCount" Height="28" Text="100" TextAlignment="Center"
                                         VerticalContentAlignment="Center" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                                <TextBlock Text="Schrittweite" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button x:Name="BtnDown" Grid.Column="4" Content="&#x25BC;  RUNTER" Width="80" Height="34" Click="BtnDown_Click"/>
                        </Grid>

                        <!-- Direct Position Input -->
                        <TextBlock Text="Direkte Zielposition (inkr.):" FontSize="11.5" Foreground="#475569" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtZPos" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                                     Text="0" TextAlignment="Right" Padding="6,2" FontFamily="Consolas, monospace" FontWeight="Bold"/>
                            <Button x:Name="BtnSetZPos" Grid.Column="2" Content="Anfahren" Height="30" Width="76"
                                     Click="BtnSetZPos_Click"/>
                        </Grid>

                        <!-- Speed Level Slider -->
                        <TextBlock Text="Geschwindigkeit (manuell)" FontSize="11.5" Foreground="#475569" Margin="0,0,0,2"/>
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="TxtSpeedLevel" DockPanel.Dock="Right" Text="Stufe: 7/10" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Slider x:Name="SldSpeedLevel" Minimum="1" Maximum="10" Value="7" TickFrequency="1"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="SldSpeedLevel_ValueChanged"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Kaskaden PID Tuning Card -->
                <GroupBox Header="Kaskaden-Regelung (PID)">
                    <StackPanel Margin="2">
                        <Button x:Name="BtnHybridTuning"
                                Content="Kaskaden-Tuning (PID) &#xF6;ffnen..."
                                Height="34"
                                Background="#F8FAFC"
                                Click="BtnHybridTuning_Click"/>

                        <!-- Collapsed legacy elements preserved for compatibility -->
                        <Grid Visibility="Collapsed">
                            <TextBox x:Name="TxtPidKpCurrent"/><TextBox x:Name="TxtPidKpNew"/>
                            <TextBox x:Name="TxtPidKiCurrent"/><TextBox x:Name="TxtPidKiNew"/>
                            <TextBox x:Name="TxtPidKdCurrent"/><TextBox x:Name="TxtPidKdNew"/>
                            <ComboBox x:Name="CmbPidPreset"/><Button x:Name="BtnPidPresetApply" Click="BtnPidPresetApply_Click"/>
                            <Button x:Name="BtnPidRead" Click="BtnPidRead_Click"/><Button x:Name="BtnPidApply" Click="BtnPidApply_Click"/>
                            <Button x:Name="BtnPidSave" Click="BtnPidSave_Click"/><Button x:Name="BtnPidLoad" Click="BtnPidLoad_Click"/>
                            <Button x:Name="BtnPidNeutral" Click="BtnPidNeutral_Click"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ======================================================= -->
        <!-- ROW 3: BOTTOM ACTIONS (RESET, STOP, CLEAR)             -->
        <!-- ======================================================= -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnReset"
                    Content="&#xB5;C Reset"
                    Width="110"
                    Height="36"
                    Background="#FEE2E2"
                    BorderBrush="#FCA5A5"
                    Foreground="#991B1B"
                    Click="BtnReset_Click"/>

            <Button x:Name="BtnStop"
                    Content="STOPP"
                    Width="110"
                    Height="36"
                    Margin="10,0,0,0"
                    Background="#FEF3C7"
                    BorderBrush="#FCD34D"
                    Foreground="#92400E"
                    Click="BtnStop_Click"/>

            <Button x:Name="BtnClearSummary"
                    Content="Summary leeren"
                    Width="160"
                    Height="36"
                    Margin="10,0,0,0"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    Foreground="#334155"
                    Click="BtnClearSummary_Click"/>
        </StackPanel>
    </Grid>
</Window>