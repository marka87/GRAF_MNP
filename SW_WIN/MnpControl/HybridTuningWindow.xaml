<Window x:Class="MnpControl.HybridTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaskaden-Tuning"
        Width="420"
        Height="380"
        MinWidth="380"
        MinHeight="320"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="90" Content="Abbrechen" IsCancel="True"/>
            <Button Width="90" Margin="8,0,0,0" Content="Speichern" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="POSITION PID (äußerer Regler -&gt; Soll-Geschwindigkeit)" Margin="0,0,0,8">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="KP"/>
                        <TextBox x:Name="TxtPosKp" Grid.Row="0" Grid.Column="2" TextAlignment="Right"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="KI"/>
                        <TextBox x:Name="TxtPosKi" Grid.Row="2" Grid.Column="2" TextAlignment="Right"/>
                        <Label Grid.Row="4" Grid.Column="0" Content="KD"/>
                        <TextBox x:Name="TxtPosKd" Grid.Row="4" Grid.Column="2" TextAlignment="Right"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="GESCHWINDIGKEIT PID (innerer Regler -&gt; Spannung)">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="KP"/>
                        <TextBox x:Name="TxtVelKp" Grid.Row="0" Grid.Column="2" TextAlignment="Right"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="KI"/>
                        <TextBox x:Name="TxtVelKi" Grid.Row="2" Grid.Column="2" TextAlignment="Right"/>
                        <Label Grid.Row="4" Grid.Column="0" Content="KD"/>
                        <TextBox x:Name="TxtVelKd" Grid.Row="4" Grid.Column="2" TextAlignment="Right"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
