<Window x:Class="MnpControl.HybridTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaskaden-Regelung (PID) Tuning"
        Width="480"
        Height="470"
        MinWidth="420"
        MinHeight="400"
        Background="#F4F6F9"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
        FontSize="13"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Bottom Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Height="32" Content="Abbrechen" IsCancel="True" Background="#FFFFFF" BorderBrush="#CBD5E1"/>
            <Button Width="100" Height="32" Margin="10,0,0,0" Content="Speichern" IsDefault="True" Background="#2563EB" BorderBrush="#1D4ED8" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnSave_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Position PID -->
                <GroupBox Header="1. POSITION PID (äußerer Lageregler -&gt; Soll-Speed)">
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="40"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="KP:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPosKp" Grid.Row="0" Grid.Column="2" TextAlignment="Right"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Empfohlen: 0.12 (P-Lageregler)" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="KI:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPosKi" Grid.Row="2" Grid.Column="2" TextAlignment="Right"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Empfohlen: 0 (nicht nötig)" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="KD:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtPosKd" Grid.Row="4" Grid.Column="2" TextAlignment="Right"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Empfohlen: 0 (nicht nötig)" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>
                    </Grid>
                </GroupBox>

                <!-- Velocity PID -->
                <GroupBox Header="2. GESCHWINDIGKEIT PID (innerer Regler -&gt; DAC Spannung)">
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="40"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="KP:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtVelKp" Grid.Row="0" Grid.Column="2" TextAlignment="Right"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Empfohlen: 0.025 (P-Gegendruck)" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="KI:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtVelKi" Grid.Row="2" Grid.Column="2" TextAlignment="Right"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="Empfohlen: 0.00025 (Haltespannung)" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="KD:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtVelKd" Grid.Row="4" Grid.Column="2" TextAlignment="Right"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="Empfohlen: 0 (verhindert Rattern)" VerticalAlignment="Center" FontSize="11.5" Foreground="#64748B"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
